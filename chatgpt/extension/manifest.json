{
  "manifest_version": 3,
  "name": "ChatGPT Meter (Claude Meter subproject)",
  "version": "0.1.0",
  "description": "A local-only usage snapshot meter for ChatGPT Web.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ChatGPT Meter"
  }
}
